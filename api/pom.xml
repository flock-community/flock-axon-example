<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>community.flock.examples.axon.webshop</groupId>
        <artifactId>flock-axon-example</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>api</artifactId>

    <properties>
        <!--
            The classes of this module are generated by wirespec from the .ws contract and carry Spring's request
            mapping annotations on the handler interfaces, which the hexagonalSpring layout reserves for controllers.
            Generated code is not subject to the guardrails; the controllers that implement the contract are.
        -->
        <byterails.skip>true</byterails.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>community.flock.wirespec.integration</groupId>
            <artifactId>wirespec-jvm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>community.flock.wirespec.plugin.maven</groupId>
                <artifactId>wirespec-maven-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>community.flock.wirespec.integration</groupId>
                        <artifactId>spring-jvm</artifactId>
                        <version>${wirespec.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>kotlin</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <input>${project.basedir}/src/main/wirespec</input>
                            <output>${project.build.directory}/generated-sources/wirespec</output>
                            <languages>
                                <language>Kotlin</language>
                            </languages>
                            <packageName>community.flock.examples.axon.webshop.api</packageName>
                            <shared>false</shared>
                            <extensionClasses>
                                <extensionClass>community.flock.wirespec.integration.spring.extension.SpringMappingAnnotationsExtension</extensionClass>
                            </extensionClasses>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
